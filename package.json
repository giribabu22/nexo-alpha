{
  "name": "nexo",
  "private": true,
  "version": "0.7.0",
  "description": "Application framework and environment for the AI era",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/giribabu22/nexo-alpha.git"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "clean": "pnpm -r --if-present clean",
    "publish:all": "pnpm build && pnpm -r publish --access public --no-git-checks",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "turbo": "^2.11.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8"
  }
}
