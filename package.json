{
  "name": "nexo",
  "private": true,
  "version": "0.4.1",
  "description": "Application framework and environment for the AI era",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --if-present clean",
    "publish:all": "pnpm build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
