{
  "name": "@nexo-alpha/hapi",
  "version": "0.3.1",
  "description": "Hapi.js HTTP adapter for the Nexo framework",
  "keywords": [
    "nexo",
    "hapi",
    "http",
    "framework",
    "typescript"
  ],
  "author": "prem1999",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexo-alpha/core": "workspace:*",
    "@hapi/hapi": "^21.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
