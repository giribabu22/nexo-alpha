{
  "name": "@nexo-alpha/hapi",
  "version": "0.8.0",
  "description": "Hapi.js HTTP adapter for the Nexo framework",
  "keywords": [
    "nexo",
    "hapi",
    "http",
    "framework",
    "typescript"
  ],
  "author": "prem1999",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test && tsc -p type-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hapi/hapi": "^21.0.0",
    "@hapi/inert": "^7.1.2",
    "@nexo-alpha/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giribabu22/nexo-alpha.git",
    "directory": "packages/hapi"
  }
}
