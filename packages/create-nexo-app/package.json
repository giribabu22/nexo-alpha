{
  "name": "@nexo-alpha/create-nexo-app",
  "version": "0.6.0",
  "description": "Scaffold a new Nexo application with backend or fullstack React templates",
  "keywords": [
    "nexo",
    "create-nexo-app",
    "scaffold",
    "generator",
    "react",
    "fullstack",
    "hapi",
    "typescript"
  ],
  "author": "prem1999",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-nexo-app": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giribabu22/nexo-alpha.git",
    "directory": "packages/create-nexo-app"
  }
}
