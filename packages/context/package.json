{
  "name": "@nexo/context",
  "version": "0.1.0",
  "description": "Application context manifest for the Nexo framework",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexo/core": "workspace:*"
  }
}
